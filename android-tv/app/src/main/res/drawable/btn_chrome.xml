<?xml version="1.0" encoding="utf-8"?>
<!-- Channels button: hairline border over translucent black (web style),
     border brightens when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="@color/btn_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/btn_border_focused" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="@color/btn_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/btn_border" />
        </shape>
    </item>
</selector>