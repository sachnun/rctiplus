{
  "name": "@rctiplus/api",
  "version": "2.1.0",
  "description": "RCTI+ live TV + catch-up replay proxy (Hono + TypeScript)",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node --import tsx src/index.ts",
    "dev": "node --import tsx --watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy:temporary": "wrangler deploy --temporary"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "hono": "^4.13.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
