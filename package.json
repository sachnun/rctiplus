{
  "name": "rcti-proxy",
  "version": "2.0.0",
  "description": "RCTI+ live TV + catch-up replay proxy for VLC, built on Hono + TypeScript",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node --import tsx src/index.ts",
    "dev": "node --import tsx --watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "hls.js": "^1.6.16",
    "hono": "^4.13.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
