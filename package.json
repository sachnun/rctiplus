{
  "name": "rctiplus",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter @rctiplus/api --filter @rctiplus/web dev",
    "build": "bun run --filter @rctiplus/web generate && bun run --filter @rctiplus/api build",
    "lint": "oxlint .",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "prepare": "bun run --filter '*' prepare",
    "deploy": "bun run --filter @rctiplus/api deploy"
  },
  "devDependencies": {
    "oxlint": "^1.89.0",
    "typescript": "^5.9.3"
  }
}
